{
  "name": "notion-sdk",
  "version": "0.2.0",
  "description": "Reusable Notion-as-CMS helpers: client factory, typed property extraction, block fetching, rich text rendering.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dist": "pnpm build && git diff --exit-code -- dist"
  },
  "peerDependencies": {
    "@notionhq/client": "^5.0.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.22.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
